# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (本地环境变量不应提交)
.env
.env*.local
dev.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cursor Agent stop hook（本地日志与限频状态）
.cursor/next-dev-restart.log
.cursor/.last-next-restart-at
